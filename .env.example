# Copie para /etc/farmcortes.env (chmod 600) ou use Environment= no systemd. Preencha só o que for usar.
FARMCORTES_DATA=/opt/farmcortes/data
FARMCORTES_YOUTUBE_ENABLED=false          # true só depois de autorizar o canal (data/secrets/youtube-token.json)
FARMCORTES_YOUTUBE_TOKEN=/opt/farmcortes/data/secrets/youtube-token.json
FARMCORTES_YOUTUBE_PRIVACY=private
FARMCORTES_YOUTUBE_TIMEZONE=America/Sao_Paulo
FARMCORTES_YOUTUBE_SCHEDULE_TIMES=12:00,18:00,21:00
FARMCORTES_DAILY_UPLOAD_LIMIT=3
FARMCORTES_WHISPER_MODEL=small
FARMCORTES_LIVE_WHISPER_MODEL=base
FARMCORTES_TELEGRAM_BOT_TOKEN=
FARMCORTES_TELEGRAM_CHAT_ID=
FARMCORTES_TIKTOK_CLIENT_KEY=
FARMCORTES_TIKTOK_CLIENT_SECRET=
# TikTok para itens aprovados da Bíblia (liga sozinho quando as chaves acima e o token OAuth existem):
# draft = rascunho na caixa de entrada do app (app sem auditoria; padrão), private = post direto SELF_ONLY
# (permitido sem auditoria), public = post direto público (só depois da auditoria do TikTok).
FARMCORTES_TIKTOK_MODE=draft

# ── Modo Bíblia (farmcortes-biblia.timer). Tudo opcional: sem chaves o vídeo ainda é gerado.
# (Comentários em linhas próprias: o EnvironmentFile do systemd não remove comentário no fim da linha.)
# true = itens da Bíblia são aprovados sozinhos (1º título) e publicam sem revisão manual.
FARMCORTES_BIBLIA_AUTO_APPROVE=false
# CSV importado uma vez para o SQLite; vazio = dados-iniciais/biblia/versiculos.csv.
FARMCORTES_BIBLIA_CSV=
# Chave da API de texto bíblico (BIBLIA_KEY no Biblia; ABíblia / pesquisarnabiblia.com.br).
FARMCORTES_BIBLIA_API_KEY=
# Fundo vertical (Pexels, com crédito do fotógrafo na descrição) e reserva (Pixabay).
FARMCORTES_PEXELS_API_KEY=
FARMCORTES_PIXABAY_API_KEY=
# Música instrumental (Jamendo), baixada uma vez para data/biblia/music.mp3.
FARMCORTES_JAMENDO_CLIENT_ID=
# IA para títulos, descrições e insights: Groq principal, Gemini reserva; sem chave usa modelo fixo.
FARMCORTES_GROQ_API_KEY=
FARMCORTES_GROQ_MODEL=llama-3.3-70b-versatile
FARMCORTES_GEMINI_API_KEY=
FARMCORTES_GEMINI_MODEL=gemini-2.0-flash
# Facebook/Instagram Reels: desligados até preencher; só publicam itens aprovados da Bíblia.
# Page Access Token de longa duração (o Instagram precisa estar vinculado à Page).
FARMCORTES_META_ACCESS_TOKEN=
FARMCORTES_META_GRAPH_VERSION=v21.0
FARMCORTES_FACEBOOK_PAGE_ID=
FARMCORTES_INSTAGRAM_USER_ID=
